# Internal Service Layer configuration (shared app dependencies).
# This stack is separate from Coolify internal services (coolify-db/coolify-redis).
# Do NOT reuse Coolify internal DB for application workloads.

# Docker network used by shared dependencies and app workloads.
INFRA_NETWORK_NAME=infra

# ===== Image Pins =====
POSTGRES_IMAGE=postgres:18.3
VALKEY_IMAGE=valkey/valkey:9.0.3-alpine
RABBITMQ_IMAGE=rabbitmq:4.2.4-management
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.13

# ===== Shared Postgres (apps) =====
POSTGRES_APPS_USER=apps_admin
POSTGRES_APPS_PASSWORD=CHANGE_ME_apps_postgres_password
POSTGRES_APPS_DB=postgres
POSTGRES_PLANE_DB=plane
POSTGRES_DOCMOST_DB=docmost
POSTGRES_APPS_HOST_PORT=5434

# ===== Shared Valkey (apps) =====
APPS_VALKEY_PASSWORD=CHANGE_ME_apps_valkey_password
VALKEY_HOST_PORT=6379

# ===== RabbitMQ (Plane) =====
PLANE_RABBITMQ_USER=plane
PLANE_RABBITMQ_PASSWORD=CHANGE_ME_plane_rabbitmq_password
PLANE_RABBITMQ_VHOST=plane
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672

# ===== SeaweedFS S3 (Plane uploads) =====
PLANE_S3_ACCESS_KEY=CHANGE_ME_plane_s3_access_key
PLANE_S3_SECRET_KEY=CHANGE_ME_plane_s3_secret_key
PLANE_S3_BUCKET=plane-uploads
SEAWEEDFS_S3_HOST_PORT=8333

# Optional runtime naming overrides.
POSTGRES_APPS_CONTAINER_NAME=postgres-apps
VALKEY_APPS_CONTAINER_NAME=valkey-apps
RABBITMQ_PLANE_CONTAINER_NAME=rabbitmq-plane
SEAWEEDFS_PLANE_CONTAINER_NAME=seaweedfs-plane
