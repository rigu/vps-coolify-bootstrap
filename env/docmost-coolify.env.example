# Docmost Community env baseline for Coolify Docker Compose service.
#
# This profile is intended to run on the shared internal service layer (`infra`):
# - Postgres container: postgres-apps
# - Valkey container: valkey-apps
#
# Recommended flow:
# 1) Generate infra env + apply infra stack first.
# 2) Generate Docmost env with scripts/generate-docmost-secrets.*
# 3) Render compose with scripts/prepare-docmost-compose.*

# Image pin (override only if required).
DOCMOST_IMAGE=docmost/docmost:latest

# Public Docmost URL.
APP_URL=https://docs.example.com

# Must be unique and secret. Generator creates this automatically when empty or CHANGE_ME.
APP_SECRET=CHANGE_ME_docmost_app_secret_min_64_hex

# Internal service layer network name.
INFRA_NETWORK_NAME=infra

# Docmost HTTP port inside container.
PORT=3000

# Infra-backed connection strings.
# scripts/generate-docmost-secrets.* rewrites these from production-infra.env when available.
DATABASE_URL=postgresql://apps_admin:CHANGE_ME_apps_postgres_password@postgres-apps:5432/docmost?schema=public
REDIS_URL=redis://default:CHANGE_ME_apps_valkey_password@valkey-apps:6379/1

# Optional storage driver.
# Keep `local` unless you intentionally configure external object storage.
STORAGE_DRIVER=local
