# Use either SSH_PUBLIC_KEY_PATH or SSH_PUBLIC_KEY for automatic first SSH key injection.
# If both remain empty/CHANGE_ME, prepare script still generates YML with warnings,
# but DEVOPS_USER will not receive ssh_authorized_keys from bootstrap init.
SSH_PUBLIC_KEY_PATH=CHANGE_ME_or_leave_empty
SSH_PUBLIC_KEY=CHANGE_ME_ssh_public_key
# 0 = append current key (default), 1 = replace authorized_keys with current key.
# Use 1 only for deliberate key cleanup/rotation, then set back to 0.
SSH_KEY_ROTATE=0

# Server defaults
TIMEZONE=UTC
SSH_PORT=2222
DEVOPS_USER=devops
# Set to true to give DEVOPS_USER passwordless sudo (NOPASSWD:ALL).
# Default false: DEVOPS_USER requires password for sudo operations.
# SECURITY: false is recommended - compromised SSH key doesn't give immediate root.
# Note: COOLIFY_SUDO_NOPASSWD_USER always has NOPASSWD:ALL (required by Coolify).
DEVOPS_USER_NOPASSWD=false
# Dedicated SSH/sudo user for Coolify server-side operations (NOPASSWD enforced by bootstrap).
# Bootstrap also syncs Coolify localhost server connection (user + SSH port) to this user.
# Must be different from DEVOPS_USER.
COOLIFY_SUDO_NOPASSWD_USER=coolify

# Additional sudo users separated by space, comma, or semicolon.
# Examples: "admin ops", "admin,ops", "admin;ops", "admin, ops;dev"
# `root` is forbidden in DEVOPS_USER / COOLIFY_SUDO_NOPASSWD_USER / ADDITIONAL_SUDO_USERS.
# ADDITIONAL_SUDO_USERS must not contain COOLIFY_SUDO_NOPASSWD_USER.
# Effective managed users are:
# DEVOPS_USER + COOLIFY_SUDO_NOPASSWD_USER + ADDITIONAL_SUDO_USERS
# Bootstrap ensures all managed users exist and adds them to sudo group.
ADDITIONAL_SUDO_USERS=

# Users with Docker group membership (root-equivalent access).
# SECURITY: Docker group is root-equivalent - members can mount /etc/shadow.
# Default: empty (no users get ambient docker access).
# Users not in DOCKER_USERS can still run `sudo docker ...` if they have sudo.
# Comma/space/semicolon separated. Must be subset of managed users.
# Example: DOCKER_USERS=devops or DOCKER_USERS=devops,admin
DOCKER_USERS=

# ============================================================================
# SSH ACCESS CONTROL (P2 #13, #14)
# Configure SSH access policy beyond the default public rate-limited access.
# ============================================================================

# SSH access mode: public (default), allowlist, or vpn-only
# - public: SSH open to all with UFW rate-limiting (default, suitable for most)
# - allowlist: SSH only from MANAGEMENT_CIDRS + SSH_TRUSTED_CIDRS
# - vpn-only: SSH only from MANAGEMENT_CIDRS (requires VPN/bastion)
# SSH_ACCESS_MODE=public

# Trusted CIDRs for SSH when SSH_ACCESS_MODE=allowlist
# These CIDRs get SSH access without rate-limiting when in allowlist mode.
# Comma/space/semicolon separated IPv4/IPv6 CIDRs.
# Example: SSH_TRUSTED_CIDRS=203.0.113.0/24,2001:db8::/32
# SSH_TRUSTED_CIDRS=

# ============================================================================
# FIREWALL (UFW) - Declarative Model
# Bootstrap resets UFW and applies rules deterministically from these variables.
# Out-of-band rules will be lost on replay - use these variables instead.
# ============================================================================

# Management CIDRs: SSH access without public rate-limit (VPN, office, etc.)
# Comma/space/semicolon separated IPv4/IPv6 CIDRs.
# These CIDRs get direct SSH access; public SSH remains rate-limited.
# Example: MANAGEMENT_CIDRS=10.100.0.0/24,203.0.113.5/32
MANAGEMENT_CIDRS=

# Extra allowed TCP ports (comma/space/semicolon separated).
# Use for monitoring (9100=node_exporter), custom services, etc.
# Example: EXTRA_ALLOWED_TCP_PORTS=9100,8080
EXTRA_ALLOWED_TCP_PORTS=

# Extra allowed UDP ports (comma/space/semicolon separated).
# Use for VPN (51820=WireGuard), DNS, etc.
# Example: EXTRA_ALLOWED_UDP_PORTS=51820
EXTRA_ALLOWED_UDP_PORTS=

# ============================================================================

# true = block public ingress to Coolify realtime ports 6001/6002 via DOCKER-USER rules
# false = keep ports publicly reachable
# SECURITY: true is recommended - realtime should go through Traefik/domain proxy
CLOSE_COOLIFY_REALTIME_PORTS=true
# true = apply Docker daemon workaround for Coolify Start Proxy ParseAddr(".../64")
# by forcing `"ipv6": false` in /etc/docker/daemon.json when needed, then restarting Docker.
# Set false only if you explicitly require Docker daemon IPv6 and manage an alternate mitigation.
DOCKER_DISABLE_IPV6_FOR_PARSEADDR_FIX=true
# Optional dedicated realtime host (example: realtime.example.com).
# If set, bootstrap writes PUSHER_HOST + PUSHER_PORT=443 + PUSHER_SCHEME=https.
# When CLOSE_COOLIFY_REALTIME_PORTS=true and this is empty, bootstrap falls back to COOLIFY_PUBLIC_DOMAIN.
# Leave empty to reuse COOLIFY_PUBLIC_DOMAIN for realtime.
COOLIFY_REALTIME_DOMAIN=

# Coolify first root account
COOLIFY_PUBLIC_DOMAIN=CHANGE_ME_coolify_public_domain
# Use a non-default admin username to reduce brute-force predictability.
COOLIFY_ROOT_USERNAME=CHANGE_ME_coolify_admin_username
COOLIFY_ROOT_USER_EMAIL=CHANGE_ME_admin_email@example.com
COOLIFY_ROOT_USER_PASSWORD=CHANGE_ME_min_16_with_upper_lower_digit_symbol

# Encryption password used for /etc/vps-coolify-bootstrap/user-passwords.enc
USER_PASSWORDS_ENCRYPTION_PASSWORD=CHANGE_ME_min_16_chars

# Public bootstrap repository source for server-side scripts
BOOTSTRAP_REPO_URL=https://github.com/rigu/vps-coolify-bootstrap.git
# Branch, tag, or commit SHA to fetch from the bootstrap repository
# P3 #28: Use specific tag for human reference, SHA for integrity
# Example: BOOTSTRAP_REPO_REF=v1.0.0
BOOTSTRAP_REPO_REF=main
# [RECOMMENDED] Expected commit SHA for supply-chain integrity verification.
# If set, bootstrap will abort if the fetched commit doesn't match this SHA.
# This protects against tampered or moved refs (tags/branches can be moved).
# Get SHA: git ls-remote https://github.com/rigu/vps-coolify-bootstrap.git main
# Or for tags: git ls-remote https://github.com/rigu/vps-coolify-bootstrap.git refs/tags/v1.0.0
# Leave empty to skip verification (acceptable for development, NOT for production).
BOOTSTRAP_EXPECTED_SHA=

# ============================================================================
# OS COMPATIBILITY
# Bootstrap supports Ubuntu 22.04/24.04 and Debian 12/13.
# Untested OS versions will fail unless explicitly allowed.
# ============================================================================

# Allow running on untested OS versions (default: false)
# Set to "true" to proceed at your own risk on untested OS versions
# ALLOW_UNTESTED_OS=false

# ============================================================================
# COOLIFY VERSION COMPATIBILITY
# Bootstrap is tested with specific Coolify versions. Operations outside
# this range may work but are not guaranteed.
# ============================================================================

# Minimum tested Coolify version (default: 4.0.0)
# COOLIFY_MIN_VERSION=4.0.0

# Maximum tested Coolify version (default: 4.99.99)
# COOLIFY_MAX_VERSION=4.99.99

# Optional overrides
TEMPLATE_FILE=../templates/vps-init.template.yml
OUTPUT_FILE=../bootstrap-artifacts/vps-coolify-init.generated.yml
