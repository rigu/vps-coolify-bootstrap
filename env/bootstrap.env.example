# Use either SSH_PUBLIC_KEY_PATH or SSH_PUBLIC_KEY.
SSH_PUBLIC_KEY_PATH=CHANGE_ME_or_leave_empty
SSH_PUBLIC_KEY=CHANGE_ME_ssh_public_key
# 0 = append current key (default), 1 = replace authorized_keys with current key.
SSH_KEY_ROTATE=0

# Server defaults
TIMEZONE=UTC
SSH_PORT=2222
PRIMARY_SUDO_USER=devops
SECONDARY_SUDO_USER=coolify
# Dedicated SSH/sudo user for Coolify server-side operations (NOPASSWD enforced by bootstrap).
# Bootstrap also syncs Coolify localhost server connection (user + SSH port) to this user.
COOLIFY_SUDO_NOPASSWD_USER=coolify

# User/group policy lists (comma-separated, no spaces)
# Keep these aligned with PRIMARY_SUDO_USER and SECONDARY_SUDO_USER.
# Post-bootstrap sudo policy keeps PRIMARY_SUDO_USER and COOLIFY_SUDO_NOPASSWD_USER passwordless.
CREATE_USERS=devops,coolify
SUDO_USERS=devops,coolify
DOCKER_USERS=devops,coolify
COOLIFY_GROUP_USERS=devops,coolify

# true = block public ingress to Coolify realtime ports 6001/6002 via DOCKER-USER rules
# false = keep ports publicly reachable
CLOSE_COOLIFY_REALTIME_PORTS=false
# Optional dedicated realtime host (example: realtime.example.com).
# If set, bootstrap writes PUSHER_HOST + PUSHER_PORT=443 + PUSHER_SCHEME=https.
# Required when CLOSE_COOLIFY_REALTIME_PORTS=true.
# Leave empty when realtime host is not used.
COOLIFY_REALTIME_DOMAIN=

# Coolify first root account
COOLIFY_PUBLIC_DOMAIN=CHANGE_ME_coolify_public_domain
# Use a non-default admin username to reduce brute-force predictability.
COOLIFY_ROOT_USERNAME=CHANGE_ME_coolify_admin_username
COOLIFY_ROOT_USER_EMAIL=CHANGE_ME_admin_email@example.com
COOLIFY_ROOT_USER_PASSWORD=CHANGE_ME_min_16_chars

# Encryption password used for /etc/vps-coolify-bootstrap/user-passwords.enc
USER_PASSWORDS_ENCRYPTION_PASSWORD=CHANGE_ME_min_16_chars

# Public bootstrap repository source for server-side scripts
BOOTSTRAP_REPO_URL=https://github.com/rigu/vps-coolify-bootstrap.git
BOOTSTRAP_REPO_REF=main

# Optional overrides
TEMPLATE_FILE=../templates/vps-init.template.yml
OUTPUT_FILE=../bootstrap-artifacts/vps-coolify-init.generated.yml
