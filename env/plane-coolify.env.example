# Plane application settings for Coolify
# Use these values when creating the Plane resource in Coolify.
# The Plane application containers must be attached to the existing
# Docker network named: infra

# ===== Public URL =====
APP_DOMAIN=projects.example.com
WEB_URL=https://projects.example.com
CORS_ALLOWED_ORIGINS=https://projects.example.com

# ===== Secret Key =====
# Used for cryptographic operations (session handling, token generation).
# Generate a long random string and keep it consistent across restarts.
SECRET_KEY=CHANGE_ME_plane_secret_key_min_50_chars

# ===== Version-Specific Compose Compatibility =====
# The recommended production compose baseline is:
# templates/plane-coolify-compose.community.v1.2.3.full-with-proxy.yml
PLANE_APP_VERSION=v1.2.3
# Optional explicit image pins for controlled upgrade/rollback.
# Leave unset to derive from PLANE_APP_VERSION via compose defaults.
# Set all of them together when you want deterministic per-service tags.
# PLANE_PROXY_IMAGE=makeplane/plane-proxy:v1.2.3
# PLANE_WEB_IMAGE=makeplane/plane-frontend:v1.2.3
# PLANE_BACKEND_IMAGE=makeplane/plane-backend:v1.2.3
# PLANE_SPACE_IMAGE=makeplane/plane-space:v1.2.3
# PLANE_ADMIN_IMAGE=makeplane/plane-admin:v1.2.3
# PLANE_LIVE_IMAGE=makeplane/plane-live:v1.2.3
# Optional alternative registry override (set explicitly per image):
# PLANE_PROXY_IMAGE=artifacts.plane.so/makeplane/plane-proxy:v1.2.3
# These are consumed by Plane's compose env anchors (application containers),
# not by a Postgres server entrypoint in this profile.
POSTGRES_USER=apps_admin
POSTGRES_PASSWORD=CHANGE_ME_apps_postgres_password
POSTGRES_DB=plane
POSTGRES_HOST=postgres-apps

# ===== Database =====
# Replace values with the matching shared app Postgres settings from
# production-infra.env. Plane gets its own database inside the shared server.
DATABASE_URL=postgresql://apps_admin:CHANGE_ME_apps_postgres_password@postgres-apps:5432/plane

# ===== Valkey =====
# Plane still expects a REDIS_URL-style setting, but Valkey is a
# Redis-protocol-compatible drop-in replacement for this single-node setup.
# COMPATIBILITY NOTE: Plane officially documents Redis, not Valkey.
# Valkey works due to protocol compatibility (BSD-licensed alternative to
# Redis 8 RSAL/SSPL). This is a project design choice, not vendor-recommended.
# This repo uses one shared Valkey instance and isolates Plane by assigning
# it logical DB 0.
REDIS_HOST=valkey-apps
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_apps_valkey_password
REDIS_URL=redis://default:CHANGE_ME_apps_valkey_password@valkey-apps:6379/0

# ===== RabbitMQ =====
RABBITMQ_HOST=rabbitmq-plane
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=plane
RABBITMQ_DEFAULT_PASS=CHANGE_ME_plane_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=plane
RABBITMQ_VHOST=plane
# Required by compose fail-fast checks. Keep this aligned with the
# RabbitMQ settings above and URL-encode reserved password characters.
AMQP_URL=amqp://plane:CHANGE_ME_plane_rabbitmq_password@rabbitmq-plane:5672/plane

# ===== S3-Compatible Storage (SeaweedFS S3 via Plane Proxy) =====
# These credentials must match the accessKey/secretKey in
# /srv/infra/seaweedfs-s3-config.json on the server, generated by
# setup-infra.sh from env/infra.env.example + templates/infra-seaweedfs-s3-config.template.json.
# For the repo's recommended `full-with-proxy` compose on Plane v1.2.3:
# - keep USE_STORAGE_PROXY enabled to avoid mixed-content browser uploads
# - use the public HTTPS URL for AWS_S3_ENDPOINT_URL so presigned upload
#   URLs stay HTTPS
# - keep BUCKET_NAME aligned with AWS_S3_BUCKET_NAME
# - the compose file provides a `plane-minio` forwarder service that maps
#   plane-proxy's expected `plane-minio:9000` target to seaweedfs-plane:8333
USE_MINIO=1
USE_STORAGE_PROXY=1
MINIO_ENDPOINT_SSL=1
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=CHANGE_ME_plane_s3_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_plane_s3_secret_key
AWS_S3_ENDPOINT_URL=https://projects.example.com
AWS_S3_BUCKET_NAME=plane-uploads
BUCKET_NAME=plane-uploads

# ===== Runtime Defaults =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=5242880
DEBUG=0
SSL_VERIFY=1
FEATURE_FLAG_SERVER_BASE_URL=
PAYMENT_SERVER_BASE_URL=
SILO_HMAC_SECRET_KEY=CHANGE_ME_plane_silo_hmac_secret
LIVE_SERVER_SECRET_KEY=CHANGE_ME_plane_live_server_secret

# ===== Optional Metadata =====
# These can remain blank unless you explicitly need to override them.
MACHINE_SIGNATURE=
DEPLOY_PLATFORM=coolify
# Keep PRIME_HOST empty for community-only self-hosting unless you
# intentionally enable a commercial endpoint.
PRIME_HOST=
